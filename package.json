{
  "name": "pi-desktop-gui",
  "version": "0.1.0",
  "private": true,
  "description": "A local desktop workspace for the Pi coding agent",
  "author": "yeyuProject",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx scripts/integration.ts",
    "test:ui": "node --import tsx scripts/test-ui.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:dir": "npm run build && electron-builder --win --dir",
    "format": "prettier --write electron shared src tests scripts vite.config.ts"
  },
  "build": {
    "appId": "io.yeyuproject.pi-desktop",
    "productName": "Pi Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "build/icon.png",
      "!**/*.map"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Pi-Desktop-${version}-win-x64.exe"
    }
  },
  "devDependencies": {
    "diff": "9.0.0",
    "ignore": "7.0.12",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/diff": "7.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
